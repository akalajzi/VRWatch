+
+# Isolated VRWatch suites: keep production feature flags and avoid unrelated
+# upstream test targets that unconditionally require disabled PDF/watermark.
+test("vrwatch_browser_tests") {
+  output_name = "vrwatch_browser_tests"
+  use_xvfb = false
+  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
+  sources = [
+    "//chrome/browser/extensions/api/vrwatch_private/vrwatch_runtime_browsertest.cc",
+    "//chrome/browser/ui/views/frame/vrwatch_hud_browsertest.cc",
+  ]
+  deps = [
+    ":test_support", ":test_support_ui",
+    "//base", "//base/test:test_support",
+    "//chrome/browser", "//chrome/browser/extensions:test_support",
+    "//chrome/browser/extensions/api/vrwatch_private:runtime",
+    "//chrome/browser/ui/views/frame",
+    "//chrome/browser/ui:browser_header",
+    "//chrome/browser/ui/views/frame:browser_view_header",
+    "//chrome/browser/ui/views/extensions:extension_view_views",
+    "//chrome/browser/ui/views/extensions:vrwatch_hud",
+    "//chrome/browser/ui/window_feature_controller",
+    "//chrome/test/base:browser_tests_runner",
+    "//content/test:test_support", "//extensions:test_support",
+    "//testing/gtest", "//ui/base", "//ui/views",
+  ]
+  data_deps = [ "//chrome:packed_resources", "//chrome:browser_tests_pak" ]
+}
+test("vrwatch_unit_tests") {
+  output_name = "vrwatch_unit_tests"
+  use_xvfb = false
+  data = [ "//chrome/test/data/extensions/good/Extensions/behllobkkfkfnphdnhnkndlbkcpglgmj/1.0.0.0/" ]
+  sources = [ "//chrome/browser/extensions/component_loader_unittest.cc" ]
+  deps = [
+    ":test_support", ":test_support_unit",
+    "//base", "//base/test:test_support",
+    "//chrome/browser", "//chrome/browser/extensions:test_support",
+    "//chrome/common", "//chrome/test/base:testing_profile",
+    "//chrome/test/base:testing_browser_process",
+    "//components/component_updater", "//components/sync_preferences:test_support",
+    "//content/test:test_support", "//extensions:test_support",
+    "//testing/gtest", "//ui/display:test_support",
+  ]
+  data_deps = [ "//chrome:packed_resources" ]
+}
