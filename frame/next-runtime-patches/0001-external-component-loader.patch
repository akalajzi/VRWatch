+TEST_F(ComponentLoaderTest, VRWatchExternalBundleIdentityAndVersion) {
+  base::ScopedTempDir directory;
+  ASSERT_TRUE(directory.CreateUniqueTempDir());
+  base::ScopedPathOverride executable_dir(base::DIR_EXE, directory.GetPath());
+  const auto root = directory.GetPath().AppendASCII("vrwatch-extension");
+  ASSERT_TRUE(base::CreateDirectory(root));
+  constexpr char kId[] = "bkjijegjmneghekcknijmioimbahmfap";
+  auto manifest = base::DictValue()
+      .Set("manifest_version", 3)
+      .Set("name", "VRWatch")
+      .Set("version", "0.1.0")
+      .Set("key", "");
+  ASSERT_TRUE(base::WriteFile(root.AppendASCII("manifest.json"),
+                             *base::WriteJson(manifest)));
+  component_loader_->set_ignore_allowlist_for_testing(false);
+  component_loader_->AddDefaultComponentExtensions(false);
+  component_loader_->LoadAll();
+  const auto* extension = ExtensionRegistry::Get(profile())
+                              ->enabled_extensions().GetByID(kId);
+  ASSERT_TRUE(extension);
+  EXPECT_EQ(extension->path(), root);
+  EXPECT_TRUE(Manifest::IsComponentLocation(extension->location()));
+
+  // Reload the bundle in both directions; no uninstall/storage-deletion path.
+  for (const char* version : {"0.2.0", "0.1.0"}) {
+    component_loader_->Remove(kId);
+    manifest.Set("version", version);
+    ASSERT_TRUE(base::WriteFile(root.AppendASCII("manifest.json"),
+                               *base::WriteJson(manifest)));
+    component_loader_->AddDefaultComponentExtensions(false);
+    component_loader_->LoadAll();
+    extension = ExtensionRegistry::Get(profile())->enabled_extensions().GetByID(kId);
+    ASSERT_TRUE(extension);
+    EXPECT_EQ(extension->version().GetString(), version);
+  }
+}
