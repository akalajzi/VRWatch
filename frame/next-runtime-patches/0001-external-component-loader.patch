 void ComponentLoader::AddDefaultComponentExtensions(
     bool skip_session_components) {
+#if BUILDFLAG(IS_LINUX)
+  // The bundle is deliberately external to GRIT. Load synchronously at startup
+  // so the first extension URL cannot race component registration. Do this
+  // before the background-component test switch: VRWatch's seccomp workaround
+  // uses --test-type on normal launches. Never replace/uninstall the old ID.
+  if (!profile_->IsOffTheRecord() && !profile_->IsGuestSession() &&
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "disable-vrwatch-component")) {
+    base::FilePath executable_dir;
+    if (base::PathService::Get(base::DIR_EXE, &executable_dir)) {
+      const auto root = executable_dir.AppendASCII("vrwatch-extension");
+      std::string contents;
+      base::ScopedAllowBlocking allow_startup_manifest_read;
+      if (base::ReadFileToStringWithMaxSize(
+              root.AppendASCII("manifest.json"), &contents, 1024 * 1024)) {
+        auto manifest = ParseManifest(contents);
+        if (manifest && TryGenerateId(*manifest) ==
+                            "bkjijegjmneghekcknijmioimbahmfap") {
+          Add(std::move(*manifest), root);
+        } else {
+          LOG(ERROR) << "VRWatch component manifest identity mismatch";
+        }
+      } else {
+        LOG(ERROR) << "VRWatch component bundle missing or unreadable";
+      }
+    }
+  }
+#endif
+
   // Do not add component extensions that have background pages here -- add them
