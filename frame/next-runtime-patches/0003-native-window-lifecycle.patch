+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/extensions/api/vrwatch_private/vrwatch_private_api.h"
+#include "chrome/browser/extensions/api/vrwatch_private/vrwatch_runtime.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/web_contents.h"
+namespace extensions {
+ExtensionFunction::ResponseAction VrwatchPrivateRequestFunction::Run() {
+  if (extension_id() != kVrwatchId || args().size() != 1 || !args()[0].is_dict())
+    return RespondNow(Error("Untrusted VRWatch caller"));
+  auto* runtime = VrwatchRuntime::ForProfile(Profile::FromBrowserContext(browser_context()));
+  if (!runtime) return RespondNow(Error("VRWatch window is closed"));
+  const auto& request = args()[0].GetDict();
+  const auto* operation = request.FindString("operation");
+  if (!operation) return RespondNow(Error("Missing operation"));
+  if (*operation == "xr") {
+    auto error = runtime->SetXR(request);
+    if (!error.empty()) return RespondNow(Error(error));
+  } else if (*operation == "hud") {
+    const auto* view = request.FindString("view");
+    if (!view || (*view != "closed" && *view != "navigation" && *view != "tabs") ||
+        !runtime->ShowHud(*view)) return RespondNow(Error("HUD unavailable"));
+  } else if (*operation == "authorizeHud") {
+    const auto* document = request.FindString("documentId");
+    if (!document || !runtime->IsHudDocument(*document))
+      return RespondNow(Error("Unowned HUD document"));
+  } else if (*operation == "stop") {
+    auto* active = runtime->browser()->GetTabStripModel()->GetActiveWebContents();
+    if (active) active->Stop();
+  } else if (*operation != "state") {
+    return RespondNow(Error("Unknown VRWatch operation"));
+  }
+  return RespondNow(WithArguments(runtime->State()));
+}
+}
