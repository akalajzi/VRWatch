--- /dev/null
+++ b/chrome/browser/extensions/api/vrwatch_private/vrwatch_runtime.cc
@@ -0,0 +1,175 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/extensions/api/vrwatch_private/vrwatch_runtime.h"
+#include <map>
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/scoped_observation.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/render_process_host_observer.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "extensions/browser/event_router.h"
+#include "extensions/browser/extension_api_frame_id_map.h"
+#include "ui/base/base_window.h"
+namespace extensions {
+namespace {
+auto& Runtimes() {
+  static base::NoDestructor<std::map<const Profile*, VrwatchRuntime*>> runtimes;
+  return *runtimes;
+}
+std::string Document(content::WebContents* contents) {
+  return contents ? ExtensionApiFrameIdMap::GetDocumentId(
+      contents->GetPrimaryMainFrame()).ToString() : std::string();
+}
+}
+class VrwatchRuntime::Origin : public content::WebContentsObserver,
+                               public content::RenderProcessHostObserver {
+ public:
+  Origin(VrwatchRuntime* owner, content::WebContents* contents, content::RenderFrameHost* frame)
+      : content::WebContentsObserver(contents), owner_(owner) {
+    process_.Observe(frame->GetProcess());
+  }
+  void Detach() { process_.Reset(); Observe(nullptr); }
+  void RenderProcessExited(content::RenderProcessHost*, const content::ChildProcessTerminationInfo&) override { owner_->LoseOrigin(); }
+  void RenderProcessHostDestroyed(content::RenderProcessHost*) override { owner_->LoseOrigin(); }
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    if (ExtensionApiFrameIdMap::GetDocumentId(frame).ToString() == owner_->document_) owner_->LoseOrigin();
+  }
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (!handle->HasCommitted() || handle->IsSameDocument()) return;
+    auto* frame = ExtensionApiFrameIdMap::GetRenderFrameHostById(web_contents(), owner_->frame_id_);
+    if (!frame || ExtensionApiFrameIdMap::GetDocumentId(frame).ToString() != owner_->document_) owner_->LoseOrigin();
+  }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    owner_->LoseOrigin();
+  }
+  void WebContentsDestroyed() override { owner_->LoseOrigin(); }
+ private:
+  raw_ptr<VrwatchRuntime> owner_;
+  base::ScopedObservation<content::RenderProcessHost, content::RenderProcessHostObserver> process_{this};
+};
+bool VrwatchRuntime::Enabled(const BrowserWindowInterface* browser) {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch("vrwatch-native") &&
+      browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+      !browser->GetProfile()->IsOffTheRecord();
+}
+VrwatchRuntime::VrwatchRuntime(BrowserWindowInterface* browser) : browser_(browser) {
+  CHECK(Enabled(browser));
+  CHECK(!Runtimes().contains(browser->GetProfile()));
+  Runtimes()[browser->GetProfile()] = this;
+  browser_->GetTabStripModel()->AddObserver(this);
+}
+VrwatchRuntime::~VrwatchRuntime() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+  Runtimes().erase(browser_->GetProfile());
+  origin_.reset();
+  Notify();
+}
+VrwatchRuntime* VrwatchRuntime::ForProfile(const Profile* profile) {
+  auto found = Runtimes().find(profile);
+  return found == Runtimes().end() ? nullptr : found->second;
+}
+base::DictValue VrwatchRuntime::State() const {
+  auto* active = browser_->GetTabStripModel()->GetActiveWebContents();
+  base::DictValue result;
+  result.Set("windowId", browser_->GetSessionID().id());
+  result.Set("activeTabId", active ? sessions::SessionTabHelper::IdForTab(active).id() : -1);
+  result.Set("documentId", Document(active));
+  result.Set("focused", browser_->GetWindow()->IsActive());
+  result.Set("hudView", hud_view_);
+  result.Set("hudDocumentId", Document(hud_));
+  result.Set("restoreSequence", restore_sequence_);
+  if (!session_.empty() && origin_ && origin_->web_contents()) {
+    result.Set("xr", base::DictValue()
+        .Set("tabId", sessions::SessionTabHelper::IdForTab(origin_->web_contents()).id())
+        .Set("documentId", document_).Set("frameId", frame_id_).Set("session", session_));
+  }
+  return result;
+}
+std::string VrwatchRuntime::SetXR(const base::DictValue& request) {
+  auto tab = request.FindInt("tabId");
+  const auto* document = request.FindString("documentId");
+  const auto* session = request.FindString("session");
+  auto active = request.FindBool("active");
+  const int frame_id = request.FindInt("frameId").value_or(0);
+  if (!tab || !document || !session || session->empty() || session->size() > 80 || !active)
+    return "Invalid XR identity";
+  auto* model = browser_->GetTabStripModel();
+  content::WebContents* contents = nullptr;
+  for (int i = 0; i < model->count(); ++i) {
+    auto* item = model->GetWebContentsAt(i);
+    if (sessions::SessionTabHelper::IdForTab(item).id() == *tab) contents = item;
+  }
+  auto* frame = contents ? ExtensionApiFrameIdMap::GetRenderFrameHostById(contents, frame_id) : nullptr;
+  if (!frame || !frame->IsActive() || !frame->IsRenderFrameLive() ||
+      ExtensionApiFrameIdMap::GetDocumentId(frame).ToString() != *document) return "Stale XR document";
+  if (*active) {
+    if (!session_.empty())
+      return session_ == *session && document_ == *document ? "" : "XR already owned";
+    // XR attachment can transfer OS focus before the content adapter reports
+    // success. The selected tab and live document remain authoritative here.
+    if (contents != model->GetActiveWebContents())
+      return "XR origin is not active";
+    origin_ = std::make_unique<Origin>(this, contents, frame);
+    frame_id_ = frame_id;
+    document_ = *document;
+    session_ = *session;
+    ShowHud("closed");
+  } else {
+    if (session_ != *session || document_ != *document) return "Stale XR session";
+    // Focus the verified surviving origin before signalling dashboard restore.
+    model->ActivateTabAt(model->GetIndexOfWebContents(contents));
+    browser_->GetWindow()->Activate();
+    origin_.reset();
+    session_.clear();
+    document_.clear();
+    ++restore_sequence_;
+  }
+  Notify();
+  return "";
+}
+void VrwatchRuntime::LoseOrigin() {
+  // The observer can call this on its own stack: detach, do not delete it here.
+  if (origin_) origin_->Detach();
+  if (session_.empty()) return;
+  session_.clear();
+  document_.clear();
+  ++restore_sequence_;
+  Notify();
+}
+void VrwatchRuntime::OnTabStripModelChanged(
+    TabStripModel* model, const TabStripModelChange&,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) ShowHud("closed");
+  if (origin_ && origin_->web_contents() &&
+      model->GetIndexOfWebContents(origin_->web_contents()) < 0) LoseOrigin();
+  Notify();
+}
+void VrwatchRuntime::SetHudHandler(base::RepeatingCallback<bool(const std::string&)> handler) {
+  hud_handler_ = std::move(handler);
+}
+bool VrwatchRuntime::ShowHud(const std::string& view) {
+  if (view != "closed" && !session_.empty()) return false;
+  return hud_handler_ && hud_handler_.Run(view);
+}
+void VrwatchRuntime::HudChanged(content::WebContents* contents, const std::string& view) {
+  hud_ = contents;
+  hud_view_ = view;
+  Notify();
+}
+bool VrwatchRuntime::IsHudDocument(const std::string& document) const {
+  return hud_ && !document.empty() && Document(hud_) == document;
+}
+void VrwatchRuntime::Notify() {
+  auto* router = EventRouter::Get(browser_->GetProfile());
+  if (router) router->DispatchEventToExtension(kVrwatchId,
+      std::make_unique<Event>(events::UNKNOWN, "vrwatchPrivate.onChanged", base::ListValue()));
+}
+}
