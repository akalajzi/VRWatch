@@ -0,0 +1,51 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/extensions/api/vrwatch_private/vrwatch_runtime.h"
+#include "base/command_line.h"
+#include "base/run_loop.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/no_renderer_crashes_assertion.h"
+#include "content/public/test/browser_test_utils.h"
+#include "ui/base/base_window.h"
+class VrwatchRuntimeBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    command_line->AppendSwitch("vrwatch-native");
+  }
+};
+IN_PROC_BROWSER_TEST_F(VrwatchRuntimeBrowserTest, DocumentAndSessionOwnership) {
+  auto* runtime = extensions::VrwatchRuntime::ForProfile(browser()->GetProfile());
+  ASSERT_TRUE(runtime);
+  browser()->GetWindow()->Activate();
+  base::RunLoop().RunUntilIdle();
+  auto state = runtime->State();
+  auto request = base::DictValue().Set("tabId", *state.FindInt("activeTabId"))
+      .Set("documentId", *state.FindString("documentId"))
+      .Set("session", "session-a").Set("active", true);
+  EXPECT_TRUE(runtime->SetXR(request).empty());
+  EXPECT_TRUE(runtime->SetXR(request).empty());  // Reconnect is idempotent.
+  request.Set("session", "session-b");
+  EXPECT_FALSE(runtime->SetXR(request).empty());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("data:text/html,new")));
+  EXPECT_FALSE(runtime->State().FindDict("xr"));
+  EXPECT_EQ(runtime->State().FindInt("restoreSequence"), 1);
+  request.Set("session", "session-a");
+  request.Set("active", false);
+  EXPECT_FALSE(runtime->SetXR(request).empty());
+}
+IN_PROC_BROWSER_TEST_F(VrwatchRuntimeBrowserTest, CrashClearsOrigin) {
+  auto* runtime = extensions::VrwatchRuntime::ForProfile(browser()->GetProfile());
+  browser()->GetWindow()->Activate();
+  base::RunLoop().RunUntilIdle();
+  auto state = runtime->State();
+  EXPECT_TRUE(runtime->SetXR(base::DictValue().Set("tabId", *state.FindInt("activeTabId"))
+      .Set("documentId", *state.FindString("documentId"))
+      .Set("session", "session-a").Set("active", true)).empty());
+  content::ScopedAllowRendererCrashes allow;
+  content::CrashTab(browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_FALSE(runtime->State().FindDict("xr"));
+}
