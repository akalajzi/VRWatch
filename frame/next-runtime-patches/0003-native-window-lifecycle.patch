+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license.
+#ifndef CHROME_BROWSER_EXTENSIONS_API_VRWATCH_PRIVATE_VRWATCH_RUNTIME_H_
+#define CHROME_BROWSER_EXTENSIONS_API_VRWATCH_PRIVATE_VRWATCH_RUNTIME_H_
+#include <memory>
+#include <string>
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+class BrowserWindowInterface;
+class Profile;
+namespace content { class WebContents; }
+namespace extensions {
+inline constexpr char kVrwatchId[] = "bkjijegjmneghekcknijmioimbahmfap";
+// Browser lifetime, independent of the extension worker and native process.
+class VrwatchRuntime : public TabStripModelObserver {
+ public:
+  explicit VrwatchRuntime(BrowserWindowInterface* browser);
+  ~VrwatchRuntime() override;
+  static bool Enabled(const BrowserWindowInterface* browser);
+  static VrwatchRuntime* ForProfile(const Profile* profile);
+  BrowserWindowInterface* browser() const { return browser_; }
+  base::DictValue State() const;
+  std::string SetXR(const base::DictValue& request);
+  void SetHudHandler(base::RepeatingCallback<bool(const std::string&)> handler);
+  bool ShowHud(const std::string& view);
+  void HudChanged(content::WebContents* contents, const std::string& view);
+  bool IsHudDocument(const std::string& document) const;
+  void Notify();
+ private:
+  class Origin;
+  void LoseOrigin();
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
+                             const TabStripSelectionChange&) override;
+  raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<Origin> origin_;
+  std::string document_;
+  int frame_id_ = 0;
+  std::string session_;
+  int restore_sequence_ = 0;
+  raw_ptr<content::WebContents> hud_ = nullptr;
+  std::string hud_view_ = "closed";
+  base::RepeatingCallback<bool(const std::string&)> hud_handler_;
+};
+}
+#endif
