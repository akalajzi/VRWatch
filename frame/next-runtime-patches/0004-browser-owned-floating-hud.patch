+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "extensions/test/test_extension_dir.h"
+#include "ui/views/widget/widget.h"
+
+class VrwatchHudBrowserTest : public extensions::ExtensionBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    ExtensionBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitch("vrwatch-native");
+    command_line->AppendSwitch("vrwatch-hud");
+  }
+  void SetUpOnMainThread() override {
+    ExtensionBrowserTest::SetUpOnMainThread();
+    directory_.WriteManifest(R"({"manifest_version":3,"name":"VRWatch test","version":"0.1.2","key":""})");
+    directory_.WriteFile(FILE_PATH_LITERAL("hud.html"), "<!doctype html><input autofocus><button>Hide</button>");
+    ASSERT_TRUE(LoadExtensionAsComponent(directory_.UnpackedPath()));
+    browser()->GetWindow()->Activate();
+    base::RunLoop().RunUntilIdle();
+  }
+  extensions::VrwatchRuntime* runtime() { return extensions::VrwatchRuntime::ForProfile(profile()); }
+ private:
+  extensions::TestExtensionDir directory_;
+};
+IN_PROC_BROWSER_TEST_F(VrwatchHudBrowserTest, NoReservedChromeOrResize) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  const auto before = contents->GetContainerBounds();
+  ASSERT_TRUE(view->IsUnframedModeEnabled());
+  auto* features = WindowFeatureController::From(browser());
+  EXPECT_FALSE(features->SupportsWindowFeature(WindowFeatureController::WindowFeature::kFeatureTabStrip));
+  EXPECT_FALSE(features->SupportsWindowFeature(WindowFeatureController::WindowFeature::kFeatureToolbar));
+  for (const char* mode : {"navigation", "tabs", "closed"}) {
+    ASSERT_TRUE(runtime()->ShowHud(mode));
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(before, contents->GetContainerBounds());
+  }
+  EXPECT_EQ(view->GetContentsSize(), view->size());
+  for (auto size : {gfx::Size(1280,800), gfx::Size(640,480), gfx::Size(300,200)}) {
+    gfx::Rect page(size);
+    EXPECT_TRUE(page.Contains(VrwatchHudController::Bounds(page, true)));
+    EXPECT_TRUE(page.Contains(VrwatchHudController::Bounds(page, false)));
+  }
+}
+IN_PROC_BROWSER_TEST_F(VrwatchHudBrowserTest, NavigationAndSecurityDismissWithoutStealingFocus) {
+  ASSERT_TRUE(runtime()->ShowHud("tabs"));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  EXPECT_EQ(*runtime()->State().FindString("hudView"), "closed");
+  ASSERT_TRUE(runtime()->ShowHud("navigation"));
+  extensions::SecurityDialogTracker::GetInstance()->AddSecurityDialog(
+      BrowserView::GetBrowserViewForBrowser(browser())->GetWidget());
+  EXPECT_EQ(*runtime()->State().FindString("hudView"), "closed");
+  EXPECT_FALSE(runtime()->ShowHud("tabs"));
+  extensions::SecurityDialogTracker::GetInstance()->RemoveSecurityDialog(
+      BrowserView::GetBrowserViewForBrowser(browser())->GetWidget());
+}
+IN_PROC_BROWSER_TEST_F(VrwatchHudBrowserTest, TabPageCannotImpersonateHud) {
+  const auto state = runtime()->State();
+  EXPECT_FALSE(runtime()->IsHudDocument(*state.FindString("documentId")));
+  EXPECT_FALSE(runtime()->IsHudDocument("forged"));
+  ASSERT_TRUE(runtime()->ShowHud("tabs"));
+  EXPECT_FALSE(runtime()->IsHudDocument(*state.FindString("documentId")));
+}
+
+IN_PROC_BROWSER_TEST_F(VrwatchHudBrowserTest, LateRendererLoadCannotReopenHud) {
+  ASSERT_TRUE(runtime()->ShowHud("tabs"));
+  ASSERT_TRUE(runtime()->ShowHud("closed"));
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  bool found = false;
+  for (views::View* child : view->children()) {
+    if (auto* hud = views::AsViewClass<ExtensionViewViews>(child)) {
+      found = true;
+      ASSERT_TRUE(content::WaitForLoadStop(hud->web_contents()));
+      EXPECT_FALSE(hud->GetVisible());
+    }
+  }
+  EXPECT_TRUE(found);
+}
