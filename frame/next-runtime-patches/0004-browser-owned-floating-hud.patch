+namespace extensions { class ExtensionViewHost; class VrwatchRuntime; }
+// A child view, never a side panel or top-level popup. The site's layout is
+// untouched. Native security widgets remain above it in the widget hierarchy.
+class VrwatchHudController : public content::WebContentsObserver,
+                             public extensions::SecurityDialogTracker::Observer,
+                             public permissions::PermissionRequestManager::Observer,
+                             public web_modal::WebContentsModalDialogManager::Observer {
+ public:
+  VrwatchHudController(BrowserView* browser_view, extensions::VrwatchRuntime* runtime);
+  ~VrwatchHudController() override;
+  bool Show(const std::string& view);
+  void Hide(bool restore_focus);
+  void Layout();
+  bool visible() const;
+  static gfx::Rect Bounds(const gfx::Rect& content, bool picker);
+  void OnSecurityDialogAdded(views::Widget*) override;
+  void OnPromptAdded() override;
+  void OnWillShow() override;
+  void OnPermissionRequestManagerDestructed() override;
+ private:
+  void DidStartNavigation(content::NavigationHandle*) override;
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override;
+  void WebContentsDestroyed() override;
+  bool Blocked() const;
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<extensions::VrwatchRuntime> runtime_;
+  std::unique_ptr<extensions::ExtensionViewHost> host_;
+  raw_ptr<ExtensionViewViews> view_ = nullptr;
+  std::string mode_ = "closed";
+  base::ScopedObservation<web_modal::WebContentsModalDialogManager,
+      web_modal::WebContentsModalDialogManager::Observer> modal_observation_{this};
+  base::ScopedObservation<permissions::PermissionRequestManager,
+      permissions::PermissionRequestManager::Observer> permission_observation_{this};
+};
+#endif
