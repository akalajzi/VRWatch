@@ -0,0 +1,130 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/ui/views/extensions/vrwatch_hud_controller.h"
+#include <algorithm>
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/extensions/api/vrwatch_private/vrwatch_runtime.h"
+#include "chrome/browser/extensions/extension_view_host.h"
+#include "chrome/browser/extensions/extension_view_host_factory.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/extensions/extension_view_views.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "components/permissions/permission_request_manager.h"
+#include "components/security_interstitials/content/security_interstitial_tab_helper.h"
+#include "components/web_modal/web_contents_modal_dialog_manager.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extension_registry.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/widget/widget.h"
+namespace {
+constexpr char kHudURL[] = "chrome-extension://bkjijegjmneghekcknijmioimbahmfap/hud.html";
+}
+VrwatchHudController::VrwatchHudController(BrowserView* browser_view,
+                                         extensions::VrwatchRuntime* runtime)
+    : browser_view_(browser_view), runtime_(runtime) {
+  runtime_->SetHudHandler(base::BindRepeating(&VrwatchHudController::Show,
+                                             base::Unretained(this)));
+  extensions::SecurityDialogTracker::GetInstance()->AddObserver(this);
+}
+VrwatchHudController::~VrwatchHudController() {
+  runtime_->SetHudHandler({});
+  runtime_->HudChanged(nullptr, "closed");
+  extensions::SecurityDialogTracker::GetInstance()->RemoveObserver(this);
+  Observe(nullptr);
+  if (view_) browser_view_->RemoveChildViewT(view_.ExtractAsDangling());
+}
+gfx::Rect VrwatchHudController::Bounds(const gfx::Rect& content, bool picker) {
+  gfx::Rect available = content;
+  available.Inset(16);
+  const int width = std::max(0, std::min(960, available.width()));
+  const int height = std::max(0, std::min(picker ? 640 : 184, available.height()));
+  return gfx::Rect(available.CenterPoint().x() - width / 2,
+                   available.bottom() - height, width, height);
+}
+bool VrwatchHudController::visible() const { return mode_ != "closed"; }
+bool VrwatchHudController::Blocked() const {
+  if (!browser_view_->GetWidget()->IsActive()) return true;
+  if (extensions::SecurityDialogTracker::GetInstance()->BrowserHasVisibleSecurityDialogs(runtime_->browser())) return true;
+  for (const auto& widget : views::Widget::GetAllOwnedWidgets(browser_view_->GetWidget()->GetNativeView())) {
+    if (widget->IsVisible() && widget->IsModal()) return true;
+  }
+  auto* contents = runtime_->browser()->GetTabStripModel()->GetActiveWebContents();
+  if (!contents) return true;
+  auto* dialogs = web_modal::WebContentsModalDialogManager::FromWebContents(contents);
+  auto* permissions = permissions::PermissionRequestManager::FromWebContents(contents);
+  auto* interstitial = security_interstitials::SecurityInterstitialTabHelper::FromWebContents(contents);
+  return (interstitial && interstitial->IsDisplayingInterstitial()) ||
+         (dialogs && dialogs->IsDialogActive()) ||
+         (permissions && permissions->IsRequestInProgress());
+}
+bool VrwatchHudController::Show(const std::string& mode) {
+  if (mode == "closed") { Hide(true); return true; }
+  if (Blocked()) { Hide(false); return false; }
+  if (!host_ || host_->web_contents()->IsCrashed() ||
+      (host_->has_loaded_once() && host_->web_contents()->GetLastCommittedURL() != GURL(kHudURL))) {
+    if (view_) browser_view_->RemoveChildViewT(view_.ExtractAsDangling());
+    host_.reset();
+    const auto* extension = extensions::ExtensionRegistry::Get(runtime_->browser()->GetProfile())
+                                ->enabled_extensions().GetByID(extensions::kVrwatchId);
+    if (!extension) return false;
+    // The side-panel *host type* supplies BrowserWindowInterface and normal
+    // modal delegation without popup auto-sizing. It is not a SidePanel view.
+    host_ = extensions::ExtensionViewHostFactory::CreateSidePanelHost(
+        *extension, GURL(kHudURL), runtime_->browser(), nullptr);
+    view_ = browser_view_->AddChildView(std::make_unique<ExtensionViewViews>(
+        runtime_->browser()->GetProfile(), host_.get()));
+    view_->SetAutoShowOnLoad(false);
+    view_->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    view_->SetVisible(false);
+    view_->Init();
+    host_->CreateRendererSoon();
+  }
+  if (!visible()) {
+    auto* contents = runtime_->browser()->GetTabStripModel()->GetActiveWebContents();
+    Observe(contents);
+    contents->StoreFocus();
+    if (auto* manager = web_modal::WebContentsModalDialogManager::FromWebContents(contents))
+      modal_observation_.Observe(manager);
+    if (auto* manager = permissions::PermissionRequestManager::FromWebContents(contents))
+      permission_observation_.Observe(manager);
+  }
+  mode_ = mode;
+  Layout();
+  view_->SetVisible(true);
+  view_->RequestFocus();
+  runtime_->HudChanged(host_->web_contents(), mode_);
+  return true;
+}
+void VrwatchHudController::Hide(bool restore_focus) {
+  if (!visible()) return;
+  mode_ = "closed";
+  permission_observation_.Reset();
+  modal_observation_.Reset();
+  view_->SetVisible(false);
+  if (restore_focus && !Blocked() && web_contents() ==
+      runtime_->browser()->GetTabStripModel()->GetActiveWebContents()) {
+    web_contents()->RestoreFocus();
+  }
+  Observe(nullptr);
+  runtime_->HudChanged(host_->web_contents(), mode_);
+}
+void VrwatchHudController::Layout() {
+  if (!view_ || !visible()) return;
+  if (Blocked()) { Hide(false); return; }
+  auto* contents = browser_view_->GetActiveContentsWebView();
+  gfx::Rect bounds = contents->GetLocalBounds();
+  bounds = views::View::ConvertRectToTarget(contents, browser_view_, bounds);
+  view_->SetBoundsRect(Bounds(bounds, mode_ == "tabs"));
+}
+void VrwatchHudController::OnSecurityDialogAdded(views::Widget*) { Hide(false); }
+void VrwatchHudController::OnPromptAdded() { Hide(false); }
+void VrwatchHudController::OnWillShow() { Hide(false); }
+void VrwatchHudController::OnPermissionRequestManagerDestructed() { permission_observation_.Reset(); Hide(false); }
+void VrwatchHudController::DidStartNavigation(content::NavigationHandle* handle) {
+  if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) Hide(false);
+}
+void VrwatchHudController::PrimaryMainFrameRenderProcessGone(base::TerminationStatus) { Hide(false); }
+void VrwatchHudController::WebContentsDestroyed() { Hide(false); }
