+IN_PROC_BROWSER_TEST_F(VrwatchHudBrowserTest,
+                       HudMessageIdentityAuthorizesRealTabCreation) {
+  ASSERT_TRUE(runtime()->ShowHud("tabs"));
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  content::WebContents* hud = nullptr;
+  for (views::View* child : view->children()) {
+    if (auto* extension_view = views::AsViewClass<ExtensionViewViews>(child)) {
+      hud = extension_view->web_contents();
+      break;
+    }
+  }
+  ASSERT_TRUE(hud);
+  ASSERT_TRUE(content::WaitForLoadStop(hud));
+  const auto document = content::EvalJs(hud,
+      "(async () => (await chrome.runtime.sendMessage('identify')).documentId)()")
+      .ExtractString();
+  EXPECT_FALSE(document.empty());
+  EXPECT_TRUE(runtime()->IsHudDocument(document));
+  EXPECT_EQ(0, content::EvalJs(hud,
+      "(async () => (await chrome.runtime.sendMessage('identify')).frameId)()"));
+  EXPECT_EQ(false, content::EvalJs(hud,
+      "(async () => (await chrome.runtime.sendMessage('identify')).hasTab)()"));
+  const int before = browser()->GetTabStripModel()->count();
+  EXPECT_EQ(true, content::EvalJs(hud,
+      "(async () => (await chrome.runtime.sendMessage('create')).created)()"));
+  EXPECT_EQ(before + 1, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(*runtime()->State().FindString("hudView"), "closed");
+  EXPECT_FALSE(runtime()->IsHudDocument(
+      *runtime()->State().FindString("documentId")));
+}
